command: [
  "python",
  "app.py"
]

env:
  - name: "DATABRICKS_WAREHOUSE_ID"
    valueFrom: "<sql-warehouse>"

  - name: "BIANOR_REPRESENTATION_CONFIG_DATABRICKS_TABLE_LOCATION"
    value: "<my_workspace.my_schema.BIANOR_REPRESENTATION_CONFIG>"

  - name: "BIANOR_PROJECTION_LAYER_CONFIG_DATABRICKS_TABLE_LOCATION"
    value: "<my_workspace.my_schema.BIANOR_PROJECTION_LAYER_CONFIG>"

  - name: "BIANOR_MAP_REPRESENTATION_PROJECTION_LAYER_CONFIG_DATABRICKS_TABLE_LOCATION"
    value: "<my_workspace.my_schema.BIANOR_MAP_REPRESENTATION_PROJECTION_LAYER_CONFIG>"

  - name: "BIANOR_PREDICTION_CONFIG_DATABRICKS_TABLE_LOCATION"
    value: "<my_workspace.my_schema.BIANOR_PREDICTION_CONFIG>"

  - name: "BIANOR_MAP_REPRESENTATION_PREDICTION_CONFIG_DATABRICKS_TABLE_LOCATION"
    value: "<my_workspace.my_schema.BIANOR_MAP_REPRESENTATION_PREDICTION_CONFIG>"
